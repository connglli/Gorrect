{
  "version": 1,
  "vm": "hotspot",
  "java": "<jdk>/bin/java",
  "collector": "g1",
  "observation": "named-roots-diagnostic",
  "vmArgs": ["-Xmx128m"],
  "support": {
    "runtime": "../../engine/build/install/gorrect/support/runtime.jar",
    "protocol": "../../engine/build/install/gorrect/support/protocol.jar",
    "observer": "../../engine/build/install/gorrect/support/libgorrect_observer.so",
    "whitebox": "<whitebox-client.jar>"
  },
  "gc": {"control": "whitebox-young"},
  "requirements": ["tagging", "named-roots", "young-gc"]
}
