gir 1;
shape Node object 2 1;
object 1 Node [2, 2] [11];
object 2 Node [1, null] [22];
root main = 1;
root saved = null;

program {
  edit: scope {
    read-root a Node main;
    read-ref b Node a 0;
    read-data value b 0;
    new_child: allocate c Node;
    write-ref a 0 c;
    write-ref c 1 b;
    write-data c 0 value;
    write-root saved c;
    mutated: checkpoint;
    release b;
    write-ref a 1 null;
    write-data c 0 99;
  }
  scope_ended: checkpoint;
  write-root main null;
  write-root saved null;
